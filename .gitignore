# Public source roots. Local research and imported projects stay on disk.
/*
!/.gitignore
!/README.md
!/play-cli
!/cli/
!/engine/
!/research/

/engine/*
!/engine/Cargo.toml
!/engine/Cargo.lock
!/engine/src/
!/engine/tests/
!/engine/examples/
/research/*
!/research/full_state/
/research/full_state/*
!/research/full_state/Cargo.toml
!/research/full_state/Cargo.lock
!/research/full_state/src/
/cli/tests/review/publish_review.py
/cli/tests/review/author_full_game.py
/cli/tests/review/next-proposal/author.py

# Build output, dependencies, local sessions and credentials.
**/target/
**/node_modules/
**/__pycache__/
*.py[cod]
.DS_Store
.env
.env.*
*.pem
*.key
*.log
*.stderr
*.stdout
**/.state/
**/test-results/
**/playwright-report/
